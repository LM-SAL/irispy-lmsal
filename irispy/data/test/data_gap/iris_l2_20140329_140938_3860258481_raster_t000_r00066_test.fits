    FRMID   =                    0 /FRM ID of each exposure (rowindex)              LFRMID  =                    0 /Length of FRM ID (rows)                         TBCOL2  =                    1 /                                                TFORM2  = 'A0      '           /                                                TTYPE2  = 'FUVFDBID'           /                                                FDBIDF  =                    0 /FUV FDB ID of each exposure (rowindex)          LFDBIDF =                    0 /Length of FUV FDB ID (rows)                     TBCOL3  =                    1 /                                                TFORM3  = 'A0      '           /                                                TTYPE3  = 'FUVCRSID'           /                                                CRSIDF  =                    0 /FUV CRS ID of each exposure (rowindex)          LCRSIDF =                    0 /Length of FUV CRS ID (rows)                     TBCOL4  =                    1 /                                                TFORM4  = 'A0      '           /                                                TTYPE4  = 'NUVFDBID'           /                                                FDBIDN  =                    0 /NUV FDB ID of each exposure (rowindex)          LFDBIDN =                    0 /Length of NUV FDB ID (rows)                     TBCOL5  =                    1 /                                                TFORM5  = 'A0      '           /                                                TTYPE5  = 'NUVCRSID'           /                                                CRSIDN  =                    0 /NUV CRS ID of each exposure (rowindex)          LCRSIDN =                    0 /Length of NUV CRS ID (rows)                     TBCOL6  =                    1 /                                                TFORM6  = 'A0      '           /                                                TTYPE6  = 'FUVfilename'        /                                                FILEF   =                    0 /FUV Filename of each exposure (rowindex)        LFILEF  =                    0 /Length of FUV Filename (rows)                   TBCOL7  =                    1 /                                                TFORM7  = 'A0      '           /                                                TTYPE7  = 'NUVfilename'        /                                                FILEN   =                    0 /NUV Filename of each exposure (rowindex)        LFILEN  =                    0 /Length of NUV Filename (rows)                   TBCOL8  =                    1 /                                                TFORM8  = 'A0      '           /                                                TTYPE8  = 'FUV Comma-delimited string list of temperatures used by iris_make_da'PDTMPFUV=                    0 /FUV string list of temperatures of each exposureLPDTMFUV=                    0 /FUV Length of string list (rows)                TBCOL9  =                    1 /                                                TFORM9  = 'A0      '           /                                                TTYPE9  = 'NUV Comma-delimited string list of temperatures used by iris_make_da'PDTMPNUV=                    0 /NUV string list of temperatures of each exposureLPDTMNUV=                    0 /NUV Length of string list (rows)                END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             